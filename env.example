# Copy to .env.local and fill in from Supabase: Project Settings -> API
# Only the PUBLIC anon key goes here. NEVER put the service_role key in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
# Minutes of inactivity before an employee session is logged out (shared kiosk PCs)
VITE_IDLE_LOGOUT_MINUTES=5
